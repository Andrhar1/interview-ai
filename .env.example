NODE_ENV=development
PORT=4000

# Auth (Fase 1+)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# PostgreSQL (self-hosted) (Fase 1+)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=interviewai
PG_USER=interviewai_app
PG_PASSWORD=

# MongoDB Atlas (Fase 2+)
MONGODB_URI=

# Gemini (Fase 3+)
GEMINI_API_KEY=
# Live (audio) model — must be a model your key can open a Live session with.
# Measured time-to-first-audio after a user turn: this model ~1.5s.
# Fallback (proven, but ~5.0s): gemini-2.5-flash-native-audio-latest
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Text model for structured-output evaluation generation (Task 4). Default: gemini-2.5-flash
GEMINI_ANALYSIS_MODEL=

# App
CORS_ORIGIN=http://localhost:5180
CV_MAX_SIZE_MB=5
CV_STORAGE_PATH=/var/www/interviewai-uploads
