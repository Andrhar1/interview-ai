# Copy to deploy/.env on the VPS. Never commit the real file.
APP_ORIGIN=https://interview.example.com
APP_PORT=8081

PG_DATABASE=interviewai
PG_USER=interviewai
PG_PASSWORD=replace-with-a-long-random-password

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CV_MAX_SIZE_MB=5
